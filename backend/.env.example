# Overtone V2 — live stack only (no Azure / AWS / Anthropic / ElevenLabs)

RECALL_API_KEY=
RECALL_API_BASE_URL=https://us-west-2.recall.ai/api/v1
RECALL_WEBHOOK_SECRET=
RECALL_SKIP_WEBHOOK_VERIFY=true

BACKEND_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:5175
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5176,http://localhost:5176
ADMIN_API_KEY=dev-admin-key
# Set true for public demo dashboards (skips admin key gate).
OPEN_DEMO_ACCESS=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_VAD_THRESHOLD=0.4
OPENAI_REALTIME_VAD_SILENCE_MS=600
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=450
OPENAI_REALTIME_INTERRUPT_RESPONSE=false
INDEXER_LLM_MODEL=gpt-4o

GEMINI_API_KEY=
REALTIME_PROVIDER=auto
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Kore
INDEXER_PROVIDER=auto
GEMINI_VISION_MODEL=gemini-2.5-flash

GCS_BUCKET=
GCS_SIGNED_URL_TTL_MINUTES=30
GCS_PREFIX=v2

DATABASE_URL=
REDIS_URL=
REDIS_KEY_PREFIX=v2

MAX_UPLOAD_BYTES=52428800
SESSION_TTL_SECONDS=86400
PRESENTATIONS_ROOT=./data/presentations
