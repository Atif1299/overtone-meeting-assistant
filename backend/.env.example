# Overtone local env. Copy to backend/.env (never commit .env).
# IN USE = the live stack (OpenAI + GCS + pgvector + Recall).
# NOT USED = leftover vendor knobs; leave blank.

# =============================================================================
# IN USE
# =============================================================================

# ── Recall.ai (required to join Meet/Zoom/Teams; leave blank until you have a key)
RECALL_API_KEY=
RECALL_API_BASE_URL=https://us-west-2.recall.ai/api/v1
RECALL_WEBHOOK_SECRET=
# true for local / first Cloud Run test only
RECALL_SKIP_WEBHOOK_VERIFY=false

# ── App URLs (start-local.sh/ps1 patch these when using Cloudflare tunnels)
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
ADMIN_API_KEY=

# ── OpenAI (embeddings always; Realtime/Vision when provider=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_VAD_THRESHOLD=0.4
OPENAI_REALTIME_VAD_SILENCE_MS=600
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=450
OPENAI_REALTIME_INTERRUPT_RESPONSE=false
VOICE_AGENT_MODE=realtime
INDEXER_LLM_MODEL=gpt-4o
INDEXER_VISION_CONCURRENCY=3

# ── Gemini (preferred for Live voice + Vision indexing when key is set)
# REALTIME_PROVIDER / INDEXER_PROVIDER: auto | openai | gemini
GEMINI_API_KEY=
REALTIME_PROVIDER=auto
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Kore
INDEXER_PROVIDER=auto
GEMINI_VISION_MODEL=gemini-2.0-flash

# ── GCS (Cloud Run file persistence). Local multipart upload works with this empty.
GCS_BUCKET=
GCS_SIGNED_URL_TTL_MINUTES=30

# ── Postgres + pgvector (Cloud Run). Empty locally = SQLite + keyword RAG fallback.
# postgresql+psycopg2://user:pass@/overtone?host=/cloudsql/x-saas-488416:us-central1:overtone-pg
DATABASE_URL=

# ── Local process settings (in use)
STORAGE_BACKEND=local
AGENTS_DB_PATH=./data/agents.db
MAX_UPLOAD_BYTES=52428800
SESSION_TTL_SECONDS=86400
SESSION_CLEANUP_INTERVAL_SECONDS=60
WEBHOOK_DEDUPE_TTL_SECONDS=3600

# =============================================================================
# NOT USED (do not fill — Azure, Anthropic, ElevenLabs, Redis, DynamoDB)
# =============================================================================
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_KEY=
# AZURE_SEARCH_INDEX_NAME=
# AZURE_BLOB_ACCOUNT_URL=
# AZURE_BLOB_ACCOUNT_KEY=
# AZURE_BLOB_CONTAINER_NAME=
# AZURE_BLOB_UPLOAD_SAS_TTL_MINUTES=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# REDIS_URL=
# REDIS_KEY_PREFIX=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DYNAMODB_PRESENTATIONS_TABLE=
