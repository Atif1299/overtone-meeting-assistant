# Dashboard UI (Vite). IN USE. Cloud Run bakes VITE_API_BASE at image build time.
# Do NOT set VITE_ADMIN_API_KEY for production/public builds — operators paste the
# admin key at login; it is stored only in sessionStorage.
VITE_API_BASE=http://127.0.0.1:8000
# VITE_ADMIN_API_KEY=   # local-only optional; omit on Cloud Build
