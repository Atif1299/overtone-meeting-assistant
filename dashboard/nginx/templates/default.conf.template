# Cloud Run sets PORT. Nginx official image runs envsubst on this file.
server {
    listen       ${PORT};
    server_name  localhost;
    root   /usr/share/nginx/html;
    index  index.html;

    # Always revalidate HTML so clients pick up new asset hashes after deploys.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
